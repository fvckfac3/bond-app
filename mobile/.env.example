# Copy to mobile/.env and fill in. Placeholders only — never commit real values.

# Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend (required — set after deploying the backend; AI insights and checkout fail without it)
EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com

# Optional: error tracking and analytics
EXPO_PUBLIC_SENTRY_DSN=optional_sentry_dsn
EXPO_PUBLIC_POSTHOG_API_KEY=optional_posthog_key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
