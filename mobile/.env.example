# BOND Mobile App - Environment Variables Template

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (deploy backend first, then add URL here)
EXPO_PUBLIC_BACKEND_URL=your_backend_api_url

# Error Tracking (Sentry) - Optional but recommended
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Analytics (PostHog) - Optional but recommended
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
