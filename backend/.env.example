# Copy to backend/.env and fill in. Placeholders only — never commit real values.

# Supabase configuration (service-role key: server-side only, never ship to the app)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI/LLM (insights + analyzers) — Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the model behind every AI feature (default: Claude Haiku 4.5)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Stripe (secret key sk_... and the signing secret of the /api/webhooks/stripe endpoint)
STRIPE_API_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# CORS: comma-separated browser origins allowed to call the API (exact origins; no
# wildcards). The native app sends no Origin header, so it isn't affected by this.
CORS_ORIGINS=https://your-domain.com
