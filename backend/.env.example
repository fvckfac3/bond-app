# BOND Backend - Environment Variables Template

# Emergent LLM Key for AI Insights
EMERGENT_LLM_KEY=your_emergent_llm_key

# CORS Origins (update with your production domains)
CORS_ORIGINS=https://your-domain.com,exp://,*.expo.dev

# MongoDB (if still using, otherwise remove)
MONGO_URL=mongodb://localhost:27017
DB_NAME=bond_production
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
